/node_modules
/public/hot
/public/storage
/storage/*.key
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
/storage/app/pdfs/*.pdf

# Compiled Blade templates. The directory must exist locally (config/view.php
# points at it), but its contents are build artifacts and must never be
# committed.
/storage/framework/views/*
!/storage/framework/views/.gitignore

# Session files, the local SQLite database and the Prometheus metrics store are
# all runtime state rebuilt on every deploy.
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm
/storage/prometheus
