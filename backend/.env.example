APP_NAME="PropertyLease Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=property_lease
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Object storage (S3). Set FILESYSTEM_DISK=documents above to route lease PDFs
# and property photos through S3 instead of local disk.
#
# Leave AWS_ENDPOINT_URL EMPTY in production to talk to real AWS.
# For local development and CI, point it at the Floci emulator:
#   host machine  -> http://localhost:4566
#   Jenkins agent -> http://floci:4566
# Floci accepts any dummy credentials, so `test`/`test` is fine.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_STORAGE_BUCKET=property-lease-documents
AWS_STORAGE_PREFIX=portal
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@propertylease.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200
SESSION_DOMAIN=localhost

PDF_PAPER=a4
PDF_ORIENTATION=portrait

# Scheduler / Invoicing
INVOICE_DUE_DAY=5
INVOICE_OVERDUE_GRACE_DAYS=3
LATE_FEE_PERCENT=2.5
