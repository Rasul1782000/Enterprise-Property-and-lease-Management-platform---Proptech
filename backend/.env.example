APP_NAME="PropertyLease Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rasul17.indevs.in
FRONTEND_URL=https://rasul17.indevs.in

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=property_lease
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Object storage (S3). Set FILESYSTEM_DISK=documents above to route lease PDFs
# and property photos through S3 instead of local disk.
#
# Leave AWS_ENDPOINT_URL EMPTY in production to talk to real AWS.
# For local development and CI, point it at the Floci emulator:
#   host machine  -> http://localhost:4566
#   Jenkins agent -> http://floci:4566
# Floci accepts any dummy credentials, so `test`/`test` is fine.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_STORAGE_BUCKET=property-lease-documents
AWS_STORAGE_PREFIX=portal
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@rasul17.indevs.in"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=rasul17.indevs.in,localhost:4200,127.0.0.1:4200
SESSION_DOMAIN=rasul17.indevs.in

PDF_PAPER=a4
PDF_ORIENTATION=portrait

# Scheduler / Invoicing
INVOICE_DUE_DAY=5
INVOICE_OVERDUE_GRACE_DAYS=3
LATE_FEE_PERCENT=2.5

# OpenWA WhatsApp Gateway
#
# Docker network: http://openwa:2785   |   Host machine: http://localhost:2785
OPENWA_BASE_URL=http://openwa:2785

# The gateway generates a random admin key on first boot and writes the
# plaintext to /app/data/.api-key inside the container. There is NO default:
#
#   docker exec openwa cat /app/data/.api-key
#
# `dev-admin-key` is NOT valid here. OpenWA only seeds that well-known value
# when ALLOW_DEV_API_KEY=true, which its production bootstrap rejects.
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Shared secret used to verify the X-OpenWA-Signature HMAC on inbound webhooks.
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# While this is empty the webhook route returns 503 rather than trusting
# unsigned callers, so inbound messages will not be delivered until it is set.
OPENWA_WEBHOOK_SECRET=

# Upper bound on a single SSE connection, in seconds. The browser reconnects
# automatically when the stream closes.
OPENWA_STREAM_MAX_SECONDS=300
