{
  "name": "property-lease-portal-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "capacitor:sync": "capacitor sync",
    "capacitor:build": "capacitor build",
    "capacitor:open": "capacitor open",
    "android:build": "capacitor android build --no-zip",
    "android:release": "capacitor android build --release --no-zip",
    "ios:build": "capacitor ios build --no-zip",
    "ios:prepare": "capacitor ios prepare",
    "serve:android": "capacitor android open",
    "serve:ios": "capacitor ios open",
    "build:mobile": "bash build-mobile.sh",
    "build:android:apk": "cd android && ./gradlew assembleDebug --parallel",
    "build:android:release": "cd android && ./gradlew assembleRelease --parallel",
    "build:ios:apk": "cd ios && xcodebuild -project EnterprisePropertyLease.xcodeproj -scheme EnterprisePropertyLease -configuration Release -archivePath build/EnterprisePropertyLease.xcarchive -archive"
  },
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@primeng/themes": "21.0.4",
    "@primeuix/themes": "2.0.3",
    "ag-grid-angular": "^33.0.0",
    "ag-grid-community": "^33.0.0",
    "chart.js": "^4.4.0",
    "ng2-charts": "^7.0.0",
    "primeicons": "^8.0.2",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.2",
    "@types/jest": "^30.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~6.0.0"
  }
}
