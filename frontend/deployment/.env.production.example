APP_NAME="PropertyLease Portal"
APP_ENV=production
APP_KEY=CHANGE_ME_GENERATE_WITH_ARTISAN
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://your-frontend.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_MANAGED_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=property_lease
DB_USERNAME=CHANGE_ME_LEAST_PRIVILEGE_USER
DB_PASSWORD=CHANGE_ME_UNIQUE_RANDOM_SECRET

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=api.example.com
SESSION_SAME_SITE=lax
REDIS_HOST=CHANGE_ME_MANAGED_REDIS_HOST
REDIS_PASSWORD=CHANGE_ME_UNIQUE_RANDOM_SECRET
REDIS_PORT=6379

FILESYSTEM_DISK=documents
AWS_ACCESS_KEY_ID=CHANGE_ME_LEAST_PRIVILEGE_STORAGE_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_UNIQUE_STORAGE_SECRET
AWS_DEFAULT_REGION=CHANGE_ME_REGION
AWS_ENDPOINT_URL=
AWS_STORAGE_BUCKET=CHANGE_ME_PRIVATE_BUCKET
AWS_STORAGE_PREFIX=portal
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
DEMO_SEED_ENABLED=false
