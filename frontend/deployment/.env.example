APP_NAME="PropertyLease Portal"
APP_ENV=local
APP_KEY=CHANGE_ME_GENERATE_WITH_ARTISAN
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=property_lease
DB_USERNAME=property_lease
DB_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_LOCAL_PASSWORD

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200

DEMO_SEED_ENABLED=false
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD_AT_LEAST_12_CHARACTERS

FILESYSTEM_DISK=documents
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://floci:4566
AWS_STORAGE_BUCKET=property-lease-documents
AWS_STORAGE_PREFIX=portal
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@propertylease.test
MAIL_FROM_NAME="${APP_NAME}"

PDF_PAPER=a4
PDF_ORIENTATION=portrait

INVOICE_DUE_DAY=5
INVOICE_OVERDUE_GRACE_DAYS=3
LATE_FEE_PERCENT=2.5

OPENWA_BASE_URL=http://openwa:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
OPENWA_STREAM_MAX_SECONDS=300
