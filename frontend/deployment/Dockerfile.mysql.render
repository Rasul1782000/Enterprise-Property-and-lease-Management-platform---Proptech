# Oracle MySQL 8 Community Server for Render's private network.
# This is the same image/config approach used by Render's official example:
# https://github.com/render-examples/mysql
FROM mysql/mysql-server:8.0

# By default the server binds to loopback only. Render's private network needs
# it listening on all interfaces so the API service can reach port 3306.
COPY frontend/deployment/mysql/render-mysql.cnf /etc/mysql/my.cnf

EXPOSE 3306
